{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --prefix website",
  "buildCommand": "npm run build --prefix website",
  "outputDirectory": "website/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/app.html"
    }
  ],
  "functions": {
    "api/index.mjs": {
      "maxDuration": 300
    }
  },
  "redirects": [
    {
      "source": "/canvas",
      "destination": "/lab/canvas",
      "permanent": true
    },
    {
      "source": "/workbench",
      "destination": "/lab/workbench",
      "permanent": true
    },
    {
      "source": "/showcase/:slug",
      "destination": "/d/:slug",
      "permanent": true
    },
    {
      "source": "/showcase",
      "missing": [
        {
          "type": "query",
          "key": "direction"
        }
      ],
      "destination": "/",
      "permanent": true
    }
  ]
}
