{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --prefix website",
  "buildCommand": "npm run build --prefix website",
  "outputDirectory": "website/dist",
  "rewrites": [
    {
      "source": "/lab/forma",
      "destination": "/lab/forma/index.html"
    },
    {
      "source": "/lab/forma/",
      "destination": "/lab/forma/index.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/lab/canvas",
      "destination": "/app.html"
    },
    {
      "source": "/lab/workbench",
      "destination": "/app.html"
    },
    {
      "source": "/directions",
      "destination": "/app.html"
    },
    {
      "source": "/showcase",
      "destination": "/app.html"
    }
  ],
  "functions": {
    "api/index.mjs": {
      "maxDuration": 300
    }
  },
  "redirects": [
    {
      "source": "/canvas",
      "destination": "/lab/canvas",
      "permanent": true
    },
    {
      "source": "/workbench",
      "destination": "/lab/workbench",
      "permanent": true
    },
    {
      "source": "/showcase/:slug",
      "destination": "/d/:slug",
      "permanent": true
    },
    {
      "source": "/showcase",
      "missing": [
        {
          "type": "query",
          "key": "direction"
        }
      ],
      "destination": "/cases",
      "permanent": true
    },
    {
      "source": "/inspiration",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/en/inspiration",
      "destination": "/en",
      "permanent": true
    }
  ],
  "images": {
    "sizes": [
      640,
      1280
    ],
    "formats": [
      "image/webp"
    ],
    "minimumCacheTTL": 604800,
