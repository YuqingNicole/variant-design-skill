{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --prefix website",
  "buildCommand": "npm run build --prefix website",
  "outputDirectory": "website/dist",
  "rewrites": [
    {
      "source": "/lab/forma",
      "destination": "/lab/forma/index.html"
    },
    {
      "source": "/lab/forma/",
      "destination": "/lab/forma/index.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api/)(?!.*\\.[A-Za-z0-9]+$).*)",
      "destination": "/app.html"
    }
  ],
  "functions": {
    "api/index.mjs": {
      "maxDuration": 300
    }
  },
  "redirects": [
    {
      "source": "/canvas",
      "destination": "/lab/canvas",
      "permanent": true
    },
    {
      "source": "/workbench",
      "destination": "/lab/workbench",
      "permanent": true
    },
    {
      "source": "/showcase/:slug",
      "destination": "/d/:slug",
      "permanent": true
    },
    {
      "source": "/showcase",
      "missing": [
        {
          "type": "query",
          "key": "direction"
        }
      ],
      "destination": "/cases",
      "permanent": true
    },
    {
      "source": "/inspiration",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/en/inspiration",
      "destination": "/en",
      "permanent": true
    }
  ],
  "images": {
    "sizes": [
      640,
      1280
    ],
    "formats": [
      "image/webp"
    ],
    "minimumCacheTTL": 604800,
    "remotePatterns": [
      {
        "protocol": "https",
        "hostname": "a-us.storyblok.com"
      },
      {
        "protocol": "https",
        "hostname": "a.storyblok.com"
      },
      {
        "protocol": "https",
        "hostname": "assets.asana.biz"
      },
      {
        "protocol": "https",
        "hostname": "assets.teenage.engineering"
      },
      {
        "protocol": "https",
        "hostname": "cdn.sanity.io"
      },
      {
        "protocol": "https",
        "hostname": "framerusercontent.com"
      },
      {
        "protocol": "https",
        "hostname": "help.figma.com"
      },
      {
        "protocol": "https",
        "hostname": "images.ctfassets.net"
      },
      {
        "protocol": "https",
        "hostname": "impeccable.style"
      },
      {
        "protocol": "https",
        "hostname": "linear.app"
      },
      {
        "protocol": "https",
        "hostname": "next.ramp.com"
      },
      {
        "protocol": "https",
        "hostname": "obsidian.md"
      },
      {
        "protocol": "https",
        "hostname": "plausible.io"
      },
      {
        "protocol": "https",
        "hostname": "ptht05hbb1ssoooe.public.blob.vercel-storage.com"
      },
      {
        "protocol": "https",
        "hostname": "res.cloudinary.com"
      },
      {
        "protocol": "https",
        "hostname": "resend.com"
      },
      {
        "protocol": "https",
        "hostname": "v0.app"
      },
      {
        "protocol": "https",
        "hostname": "www.notion.com"
      },
      {
        "protocol": "https",
        "hostname": "www.pentagram.com"
      },
      {
        "protocol": "https",
        "hostname": "www.raycast.com"
      }
    ]
  }
}
