# Configure one provider. Keys stay on the server and are never bundled into the browser.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-5
# Optional role routing. Omit these to use ANTHROPIC_MODEL for every stage.
# ANTHROPIC_PLANNER_MODEL=
# ANTHROPIC_BUILDER_MODEL=
# ANTHROPIC_REVIEWER_MODEL=
# ANTHROPIC_API_URL= # Optional full Messages endpoint; overrides ANTHROPIC_BASE_URL.

# Or use OpenAI instead.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.6-luna
# OPENAI_PLANNER_MODEL=
# OPENAI_BUILDER_MODEL=
# OPENAI_REVIEWER_MODEL=

# Optional upstream request timeout in milliseconds (default: 120000).
# MODEL_TIMEOUT_MS=120000
